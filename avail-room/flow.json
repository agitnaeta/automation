    {
      "parameters": {
        "jsCode": "const apiResponse = $input.first().json;\nconst days = apiResponse?.data?.days || [];\n\nconst startDate = '2026-04-01';\nconst endDate   = '2026-04-30';\n\nconst listingId = days.length > 0 ? days[0].listingId : null;\n\nif (!listingId) {\n  return [{ json: {\n    listing_id: null,\n    start_date: startDate,\n    end_date: endDate,\n    calendar_rows: [],\n    reservation_rows: [],\n    has_reservations: false,\n    error: 'No listingId in response'\n  }}];\n}\n\nconst calendarRows = days.map(day => ({\n  date:                day.date,\n  listing_id:          day.listingId,\n  currency:            day.currency            || 'IDR',\n  price:               day.price               ?? null,\n  base_price:          day.basePrice           ?? null,\n  rate_strategy_price: day.rateStrategyPrice   ?? null,\n  min_nights:          day.minNights           ?? 1,\n  max_nights:          day.maxNights           ?? 365,\n  status:              day.status              || 'available',\n  cta:                 day.cta                 ?? false,\n  ctd:                 day.ctd                 ?? false,\n  request_to_book:     day.requestToBook       ?? false,\n  blocks:              day.blocks              ?? null,\n  rules_applied:       day.rulesApplied?.length ? day.rulesApplied : null,\n  reservation_id:      day.reservation?._id   ?? null,\n}));\n\nconst reservationMap = {};\nfor (const day of days) {\n  const r = day.reservation;\n  if (r && r._id) reservationMap[r._id] = r;\n}\n\nconst reservationRows = Object.values(reservationMap).map(r => ({\n  id:                r._id,\n  listing_id:        r.listingId           || listingId,\n  account_id:        r.accountId           || null,\n  confirmation_code: r.confirmationCode    || null,\n  source:            r.source              || null,\n  status:            r.status              || null,\n  check_in_date:     r.checkIn  ? r.checkIn.substring(0, 10)  : null,\n  check_out_date:    r.checkOut ? r.checkOut.substring(0, 10) : null,\n  check_in:          r.checkIn             || null,\n  check_out:         r.checkOut            || null,\n  nights_count:      r.nightsCount         ?? null,\n  guests_count:      r.guestsCount         ?? null,\n  num_adults:        r.numAdults           ?? 0,\n  num_children:      r.numChildren         ?? 0,\n  num_infants:       r.numInfants          ?? 0,\n  guest_id:          r.guestId             || null,\n  guest_full_name:   r.guestFullName       || null,\n  platform:          r.platform            || null,\n  listing_nickname:  r.listingNickname     || null,\n  listing_timezone:  r.listingTimezone     || null,\n  balance_due:       r.balanceDue          ?? null,\n  host_payout:       r.hostPayout          ?? null,\n  total_paid:        r.totalPaid           ?? null,\n  fare_accommodation:r.fareAccommodation   ?? null,\n  currency:          r.currency            || 'IDR',\n  guest_stay_status: r.guestStayStatus     || null,\n}));\n\nreturn [{ json: {\n  listing_id:       listingId,\n  start_date:       startDate,\n  end_date:         endDate,\n  calendar_rows:    calendarRows,\n  reservation_rows: reservationRows,\n  has_reservations: reservationRows.length > 0,\n}}];\n"
      },
