      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nfunction cleanNum(val) {\n  if (val === null || val === undefined || val === 'Not set') return null;\n  const n = Number(val);\n  return isNaN(n) ? null : n;\n}\n\nreturn [{\n  json: {\n    id:               input.id,\n    title:            input.title            || null,\n    location:         input.location         || null,\n    bedrooms:         input.bedrooms         ?? null,\n    bathrooms:        cleanNum(input.bathrooms),\n    accommodates:     input.accommodates     ?? null,\n    min_nights:       input.minNights        ?? 1,\n    base_price:       cleanNum(input.basePrice),\n    currency:         input.currency         || 'IDR',\n    weekly_factor:    cleanNum(input.weeklyFactor),\n    monthly_factor:   cleanNum(input.monthlyFactor),\n    weekly_discount:  cleanNum(input.weeklyDiscount),\n    monthly_discount: cleanNum(input.monthlyDiscount),\n    cleaning_fee:     cleanNum(input.cleaningFee),\n    extra_person_fee: cleanNum(input.extraPersonFee) ?? 0,\n    security_deposit: cleanNum(input.securityDeposit),\n  }\n}];\n"
