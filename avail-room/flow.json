      "parameters": {
        "jsCode": "const results = $input.first().json.results || [];\nconst output = [];\n\nfor (const listing of results) {\n  const prices = listing.prices || {};\n  const weeklyFactor  = prices.weeklyPriceFactor  ?? null;\n  const monthlyFactor = prices.monthlyPriceFactor ?? null;\n\n  output.push({\n    id:              listing._id,\n    title:           listing.nickname || listing.title || \"Untitled\",\n    location:        listing.address?.city || \"Canggu, Bali\",\n    bedrooms:        listing.bedrooms    || 0,\n    bathrooms:       listing.bathrooms   || 0,\n    accommodates:    listing.accommodates || 0,\n    minNights:       listing.terms?.minNights ?? 1,\n    basePrice:       prices.basePrice     || 0,\n    currency:        prices.currency      || \"IDR\",\n    weeklyFactor:    weeklyFactor,\n    monthlyFactor:   monthlyFactor,\n    weeklyDiscount:  weeklyFactor  != null ? Math.round((1 - weeklyFactor)  * 100) : \"Not set\",\n    monthlyDiscount: monthlyFactor != null ? Math.round((1 - monthlyFactor) * 100) : \"Not set\",\n    cleaningFee:     prices.cleaningFee       ?? \"Not set\",\n    extraPersonFee:  prices.extraPersonFee     ?? \"Not set\",\n    securityDeposit: prices.securityDepositFee ?? \"Not set\",\n  });\n}\n\nreturn output.map(i => ({ json: i }));\n"
      },
